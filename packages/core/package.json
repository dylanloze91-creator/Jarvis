{
  "name": "@jarvis/core",
  "version": "0.1.0",
  "private": true,
  "description": "Cœur logique de Jarvis : providers IA, tool manager, agent, historique. Sans dépendance à Electron.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./trieur/validation": {
      "types": "./dist/trieur/validation.d.ts",
      "default": "./dist/trieur/validation.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lab": "tsc -p tsconfig.json && node scripts/lab-bench.mjs",
    "lab:generate": "tsc -p tsconfig.json && node scripts/lab-generate.mjs",
    "lab:clean": "tsc -p tsconfig.json && node scripts/lab-clean.mjs",
    "lab:prepare": "tsc -p tsconfig.json && node scripts/lab-prepare.mjs",
    "lab:compare": "tsc -p tsconfig.json && node scripts/lab-compare.mjs",
    "trieur:extraire": "tsc -p tsconfig.json && node scripts/trieur-extraire.mjs",
    "trieur:trier": "tsc -p tsconfig.json && node scripts/trieur-trier.mjs",
    "trieur:banc": "tsc -p tsconfig.json && node scripts/trieur-banc.mjs",
    "trieur:generer": "tsc -p tsconfig.json && node scripts/trieur-generer.mjs",
    "trieur:preparer": "tsc -p tsconfig.json && node scripts/trieur-preparer.mjs",
    "carte:utilisation": "tsc -p tsconfig.json && node scripts/carte-utilisation.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
