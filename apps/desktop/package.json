{
  "name": "@jarvis/desktop",
  "version": "0.4.22",
  "private": true,
  "description": "Application de bureau Jarvis (Electron)",
  "main": "./out/main/index.js",
  "author": "thedexios",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "npm run setup:voice && electron-vite dev",
    "build": "npm run setup:voice && npm run icons && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "setup:voice": "node scripts/setup-voice-assets.mjs",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:win:publish": "npm run build && electron-builder --win --publish always",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@jarvis/core": "*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.47.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vosk-browser": "0.0.8"
  }
}
