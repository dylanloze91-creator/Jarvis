# Enceinte Jarvis (5.0.64) — ESP32-S3-DevKitC-1 N8R8 (ou N16R8), ESP-IDF 5.5, ESP-SR.

CONFIG_IDF_TARGET="esp32s3"

# Flash : 8 Mo utilisés (une carte N16R8 en a 16, les 8 premiers suffisent). Table des partitions du
# projet, avec la partition « model » du mot de réveil.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# PSRAM octale 8 Mo (N8R8, N16R8). Pour une carte N8R2 (PSRAM quad, 2 Mo), remplacer OCT par QUAD.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Processeur à 240 MHz, caches larges : recommandé par Espressif pour ESP-SR.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ESP-SR : modèle dans la flash, mot de réveil « Jarvis », pas de reconnaissance de commandes.
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_JARVIS_TTS=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# Réseau : rien en HTTPS, le pont est sur le Wi-Fi de la maison.
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n

# Journal série lisible.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=n
