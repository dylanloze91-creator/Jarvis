# Enregistrements vocaux réels utilisés pour le test de régression du mot de
# réveil : jamais commités (voix d'une personne réelle) — voir
# apps/desktop/test-fixtures/README.md pour les y déposer localement.
apps/desktop/test-fixtures/*.mp3
apps/desktop/test-fixtures/*.wav

# Runtime ONNX, Whisper et openWakeWord (téléchargés par setup:voice).
apps/desktop/voice-assets/*
!apps/desktop/voice-assets/README.md

# Entraînement de l'élève (5.0.65) : environnement Python, llama.cpp, runs et exports
# (plusieurs Go, et les runs contiennent des copies des exemples) — rien de tout cela en dépôt.
training/.venv/
training/llama.cpp/
training/runs/
training/export/
__pycache__/
.pytest_cache/

# Studio de voix inventée (5.0.67) : audio, corpus, exports — jamais en dépôt.
voice-studio/.venv/
voice-studio/candidates/
voice-studio/corpus/
voice-studio/export/
voice-studio/checkpoints/
voice-studio/**/__pycache__/
