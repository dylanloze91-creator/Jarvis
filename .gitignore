node_modules/
dist/
out/
release/
*.log
.DS_Store
.env
.env.*
!.env.example
coverage/
.vite/
agent-tools/

# Enregistrements vocaux réels utilisés pour le test de régression du mot de
# réveil : jamais commités (voix d'une personne réelle) — voir
# apps/desktop/test-fixtures/README.md pour les y déposer localement.
apps/desktop/test-fixtures/*.mp3
apps/desktop/test-fixtures/*.wav

# Runtime ONNX, Whisper et openWakeWord (téléchargés par setup:voice).
apps/desktop/voice-assets/*
!apps/desktop/voice-assets/README.md

# Programme d'enceinte compilé (setup:speaker-firmware). Jamais de .bin dans git.
apps/desktop/speaker-firmware/*
!apps/desktop/speaker-firmware/LISEZMOI.md
!apps/desktop/speaker-firmware/LICENCES.md
!apps/desktop/speaker-firmware/.gitkeep

# Entraînement de l'élève (5.0.65) : environnement Python, llama.cpp, runs et exports
# (plusieurs Go, et les runs contiennent des copies des exemples) — rien de tout cela en dépôt.
training/.venv/
training/llama.cpp/
training/runs/
training/export/
__pycache__/
.pytest_cache/

# Module images (Forge + SDXL) : rien de lourd dans Git.
# Forge est installe hors du depot (C:/dev/Forge) et les images dans C:/dev/Jarvis_images.
*.safetensors
*.ckpt
*.gguf
training/lora/jeux/
training/lora/sorties/
training/lora/*.safetensors
Jarvis_images/
